<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <!-- Center Mapsforge Map View -->
    <org.mapsforge.map.android.view.MapView
        android:id="@+id/tron_map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD Overlay -->
    <LinearLayout
        android:id="@+id/tron_top_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#D00A0E17"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME"
                android:textColor="#8892B0"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tron_tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#00F0FF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED"
                android:textColor="#8892B0"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tron_tv_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 km/h"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARENA"
                android:textColor="#8892B0"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tron_tv_radius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250 m"
                android:textColor="#FF0055"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="#8892B0"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tron_tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY"
                android:textColor="#00FF66"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sub HUD for P2P Match & Opponent Status -->
    <LinearLayout
        android:id="@+id/tron_p2p_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tron_top_hud"
        android:background="#B00A0E17"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tron_tv_p2p_match"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ROOM: TRON-1"
            android:textColor="#00F0FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tron_tv_p2p_opponent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RIVAL: SEARCHING"
            android:textColor="#FFAA00"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tron_tv_p2p_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="P2P: STANDALONE"
            android:textColor="#8892B0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Bottom Controls Overlay -->
    <LinearLayout
        android:id="@+id/tron_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#D00A0E17"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_tron_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="#00F0FF"
            android:textColor="#000000"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="START" />

        <Button
            android:id="@+id/btn_tron_shrink_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="#202A3C"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="RING: OFF" />

        <Button
            android:id="@+id/btn_tron_p2p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="#202A3C"
            android:textColor="#00F0FF"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="LOBBY" />

        <Button
            android:id="@+id/btn_tron_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="#202A3C"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="RESET" />

        <Button
            android:id="@+id/btn_tron_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FF0055"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="EXIT" />
    </LinearLayout>

</RelativeLayout>

