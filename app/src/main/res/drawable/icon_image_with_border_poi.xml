<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle"
            android:angle="270">
            <corners android:radius="3dp"/>
            <gradient
                android:startColor="#90a4ae"
                android:endColor="#90a4ae"
                android:angle="90"
                android:centerColor="#eceff1"/>
            <stroke
                android:width="1dp"
                android:color="#ffff66"/>
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/marker_icon_red"/>
    </item>
</layer-list>
