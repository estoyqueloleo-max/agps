<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/fdrowimage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="2dp"
        android:paddingStart="3dp"
        android:paddingEnd="5dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:id="@+id/fdrowtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@+id/fd_rowtext"
        android:singleLine="false"
        android:layout_alignTop="@+id/fdrowimage"
        android:layout_toEndOf="@+id/fdrowimage"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/fdrowdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fdrowtext"
        android:layout_toEndOf="@+id/fdrowimage"/>
</RelativeLayout>
