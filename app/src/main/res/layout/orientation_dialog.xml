<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/radio_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/blue_circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/blue_circle"
            android:drawableRight="@drawable/pallino_blu"
            android:onClick="onRadioButtonClicked"/>
        <RadioButton
            android:id="@+id/orientation_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/orientation_arrow"
            android:drawableRight="@drawable/freccia_blu"
            android:onClick="onRadioButtonClicked"/>
    </RadioGroup>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/works_if_calibrated_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/radio_buttons"
        android:layout_marginHorizontal="10dp"/>
</RelativeLayout>
