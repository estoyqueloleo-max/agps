<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/relativeLayout01"
    android:background="@drawable/button_border_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/cloud_header1"
        android:background="@drawable/button_border_rounded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <Button
            android:textSize="14sp"
            android:id="@+id/ls_go_back"
            android:background="@drawable/button_x_two_xml"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="10dp"
            android:layout_alignParentLeft="true"
            android:onClick="onClickGoBack"
            android:textAlignment="center"/>
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/ftp_archive_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_toRightOf="@+id/ls_go_back"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ListView
        android:id="@+id/list_ftp"
        android:background="@drawable/button_border_grey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:listSelector="@android:color/holo_orange_light"
        android:choiceMode="singleChoice"
        android:layout_below="@+id/cloud_header1"
        android:fadeScrollbars="false"
        android:layout_alignParentEnd="true"/>
    <ProgressBar
        android:id="@+id/sftp_connect_progress"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:indeterminate="true"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <include layout="@layout/progress_window_download"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include layout="@layout/snack_coordinator_layout"/>
    </LinearLayout>
</RelativeLayout>
