<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:stretchColumns="*">
    <TableRow>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/edit_jpg"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="2dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/edit_jpg_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_mode_rename36"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/edit_jpg_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/edit_comment"
                android:layout_below="@+id/edit_jpg_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/load_add_file"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="2dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/load_add_file_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/outline_camera_orange"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/load_add_file_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/show"
                android:layout_below="@+id/load_add_file_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/share_file"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="2dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/share_file_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_share_black_24dp"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/share_file_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/share"
                android:layout_below="@+id/share_file_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/rename_file"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="2dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/rename_file_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_mode_rename36"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/rename_file_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/rename"
                android:layout_below="@+id/rename_file_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/delete_file"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="2dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/delete_file_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_delete_black_24dp"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/delete_file_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/delete"
                android:layout_below="@+id/delete_file_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
    </TableRow>
</TableLayout>
