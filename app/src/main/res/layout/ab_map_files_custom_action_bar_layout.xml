<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:stretchColumns="*">
    <TableRow>
        <RelativeLayout
            android:id="@+id/load_add_file"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="2dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/load_add_file_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_map_black_36dp"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/load_add_file_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/select"
                android:layout_below="@+id/load_add_file_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/update_map"
            android:background="@drawable/button_border_grey"
            android:visibility="invisible"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="2dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/update_map_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_cloud_download_black_36dp"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/update_map_txt"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/update"
                android:layout_below="@+id/update_map_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/delete_map"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="2dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/delete_file_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_delete_black_24dp"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/delete_file_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/delete"
                android:layout_below="@+id/delete_file_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
    </TableRow>
</TableLayout>
