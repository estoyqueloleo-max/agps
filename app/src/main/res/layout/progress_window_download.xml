<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/progress_window_downld"
    android:background="@drawable/button_border_bianco"
    android:padding="10dp"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:layout_centerHorizontal="true"
    android:layout_centerVertical="true"
    android:fontFamily="Arial">
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:id="@+id/progressTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"/>
    <Button
        android:textColor="@android:color/black"
        android:id="@+id/dwld_stop_button"
        android:background="@drawable/ic_clear_black_24dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_margin="2dp"
        android:onClick="onClick_StopDownload"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/progressBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_below="@+id/dwld_stop_button">
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:id="@+id/progressValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"/>
        <ProgressBar
            android:id="@+id/ftp_progress_bar"
            android:background="#c4fced"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_margin="3dp"
            android:max="100"
            android:indeterminate="false"
            android:layout_below="@+id/progressValue"
            android:layout_alignParentStart="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:id="@+id/progressValPercent"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_above="@+id/ftp_progress_bar"
            android:layout_alignEnd="@+id/ftp_progress_bar"/>
    </RelativeLayout>
</RelativeLayout>
