<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gps_data_lavagna"
    android:background="@drawable/button_chiaro"
    android:visibility="invisible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="2dp">
    <Button
        android:id="@+id/lavagna_gps_off"
        android:background="@drawable/ic_clear_black_24dp"
        android:padding="2dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="0dp"
        android:layout_alignParentLeft="true"
        android:onClick="onClick_lavagnaOff"
        style="?android:attr/borderlessButtonStyle"/>
    <Button
        android:id="@+id/lavagna_gps_shared"
        android:background="@drawable/ic_share_black_24dp"
        android:padding="2dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        android:layout_toRightOf="@+id/lavagna_gps_off"
        android:onClick="onClick_sendMyPosition"
        style="?android:attr/borderlessButtonStyle"/>
    <Button
        android:id="@+id/lavagna_gps_lat_lon_in"
        android:background="@drawable/ic_push_pin_red_32dp"
        android:padding="2dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        android:layout_toRightOf="@+id/lavagna_gps_shared"
        android:onClick="onClick_InputLanLon"
        style="?android:attr/borderlessButtonStyle"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:id="@+id/lavagna_gps_titolo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lavagna_gps_shared"
        android:layout_centerHorizontal="true"
        android:textAllCaps="true"/>
    <ScrollView
        android:scrollbarThumbVertical="@drawable/custom_scroll_style"
        android:id="@+id/lavagna_gps_scroll"
        android:background="@drawable/square_border_bianco"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:layout_below="@+id/lavagna_gps_titolo"
        android:fadeScrollbars="false">
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:id="@+id/lavagna_gps_text"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </ScrollView>
</RelativeLayout>
