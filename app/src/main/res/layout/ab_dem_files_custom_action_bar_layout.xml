<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:stretchColumns="*">
    <TableRow>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/show_dems"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/show_dems_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_crop_original_black_36dp"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/show_dems_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/dems_domains"
                android:layout_below="@+id/show_dems_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/delete_dem"
            android:background="@drawable/button_border_grey"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:onClick="onClickActionBar">
            <ImageButton
                android:id="@+id/delete_dem_image"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="0dp"
                android:src="@drawable/ic_delete_black_24dp"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/delete_dem_text"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:text="@string/delete"
                android:layout_below="@+id/delete_dem_image"
                android:layout_centerHorizontal="true"
                android:onClick="onClickActionBar"/>
        </RelativeLayout>
    </TableRow>
</TableLayout>
