<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.AppCompat.Light"
    android:id="@+id/graph_window"
    android:background="@drawable/button_chiaro"
    android:visibility="invisible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="2dp">
    <Button
        android:id="@+id/graph_off"
        android:background="@drawable/ic_clear_black_24dp"
        android:padding="2dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="1dp"
        android:onClick="onClick_GraphWindowsOff"
        android:layout_alignParentStart="true"
        style="?android:attr/borderlessButtonStyle"/>
    <Button
        android:id="@+id/walk"
        android:background="@drawable/walking_freccia_destra"
        android:padding="2dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="1dp"
        android:onClick="onClick_showWalking"
        android:layout_toEndOf="@+id/graph_off"
        style="?android:attr/borderlessButtonStyle"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:ellipsize="end"
        android:id="@+id/graph_txt"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="1dp"
        android:maxLines="2"
        android:layout_toEndOf="@+id/walk"/>
    <com.jjoe64.graphview.GraphView
        android:id="@+id/graph_elevation"
        android:background="@color/PowderBlue"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_margin="1dp"
        android:layout_below="@+id/walk"/>
    <RelativeLayout
        android:theme="@style/CardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/graph_elevation"
        android:layout_alignParentLeft="true">
        <ImageView
            android:id="@+id/image_blu"
            android:background="@drawable/quadrato_blu"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="3dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="10sp"
            android:id="@+id/txt_gps"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="gps"
            android:layout_toEndOf="@+id/image_blu"/>
        <ImageView
            android:id="@+id/image_verde"
            android:background="@drawable/quadrato_verde"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="3dp"
            android:layout_below="@+id/image_blu"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="10sp"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="dem"
            android:layout_below="@+id/image_blu"
            android:layout_toEndOf="@+id/image_verde"/>
    </RelativeLayout>
</RelativeLayout>
