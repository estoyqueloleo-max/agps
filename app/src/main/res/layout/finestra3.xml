<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/finestra3"
    android:visibility="invisible"
    android:layout_width="90dp"
    android:layout_height="wrap_content"
    android:layout_margin="1dp">
    <RelativeLayout
        android:id="@+id/blocco30"
        android:background="@drawable/background_spinner2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="0dp">
        <ImageView
            android:id="@+id/image3"
            android:background="@drawable/distance64"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/label31"
            android:paddingLeft="1dp"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:paddingEnd="1dp"
            android:layout_toEndOf="@+id/image3"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/label32"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_below="@+id/label31"
            android:layout_toEndOf="@+id/image3"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:gravity="right"
            android:id="@+id/data30"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_below="@+id/image3"/>
    </RelativeLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/black"
        android:gravity="right"
        android:id="@+id/data31"
        android:background="@drawable/background_spinner2"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_below="@+id/blocco30"/>
</RelativeLayout>
